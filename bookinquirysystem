import java.util.HashMap;
import java.util.LinkedList;
public class bookinquirysystem {
public static void main(String[] args) {

    String[] titles = { "The Great Gatsby", "Sherlock", "Java Programming", "Data Structures" };
    int[] isbns = { 1234, 4321, 2468, 8642 };
    String targetTitle = "Java Programming";
    System.out.println("\n--- Book Inquiry System Test ---");
    System.out.println("Searching for: " + targetTitle + "\n");

    System.out.println("\n--- Book Inquiry System Test ---");
    System.out.println("Searching for: " + targetTitle + "\n");

    public static void searchUsingHashMap(String[] titles, int[] isbns, String target) {
        HashMap<String, Integer> bookMap = new HashMap<>();

        for (int i = 0; i < titles.length; i++) {
            bookMap.put(titles[i], isbns[i]);
        }

        if (bookMap.containsKey(target)) {
            System.out.println("[HashMap] Found: " + target + " (ISBN: " + bookMap.get(target) + ")");
        } else {
            System.out.println("[HashMap] Book not found.");
        }
    }
}
